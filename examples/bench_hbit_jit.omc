# HBit JIT + harmony-weighted SGD + substrate-dispatch benchmarks.
#
# Three measurements:
#   1. JIT speedup where it actually fires: pure-integer hot functions.
#      _prom_lcg_step takes an integer arg → JIT dispatch fires.
#      We call it 50k times and compare wall-clock inside OMC.
#
#   2. Training speed: JIT vs tree-walk on the full Prometheus loop.
#      (Tape ops dominate; integer fns are not in the hot path.)
#
#   3. Substrate-modulated dispatch overhead: how much does the harmony
#      check cost per dispatch? Run 50k calls with OMC_HBIT_JIT_HARMONY
#      set vs not, and measure inside OMC via time_ms().
#
# Run as:
#   ./omc examples/bench_hbit_jit.omc           # tree-walk
#   OMC_HBIT_JIT=1 ./omc examples/bench_hbit_jit.omc    # JIT

import "examples/lib/prometheus.omc";

# ---- 1. Integer hot-function timing ------------------------------------------

fn bench_lcg_chain(n, seed) {
    h s = seed;
    h i = 0;
    while i < n {
        s = _prom_lcg_step(s);
        i += 1;
    }
    return s;
}

fn run_lcg_bench() {
    h iters = 50000;
    h t0 = time_ms();
    h final_state = bench_lcg_chain(iters, 42);
    h t1 = time_ms();
    h ms = t1 - t0;
    print(concat_many("[LCG]  ", to_string(iters), " calls  final=",
        to_string(final_state), "  time=", to_string(ms), "ms"));
    return ms;
}

# ---- 2. Prometheus training timing -------------------------------------------
fn make_corpus() {
    h text = "abcabcabcabcabcabcabcabcabc";
    h ids = [];
    h i = 0;
    while i < str_len(text) {
        h ch = str_slice(text, i, i + 1);
        h idx = 0;
        if ch == "b" { idx = 1; }
        elif ch == "c" { idx = 2; }
        arr_push(ids, idx);
        i += 1;
    }
    return ids;
}

fn build_small_model(seed) {
    h L1 = prom_linear_new(3, 8, seed);
    h L2 = prom_linear_new(8, 3, dict_get(L1, "rng_state"));
    h m = dict_new();
    dict_set(m, "L1", L1);
    dict_set(m, "L2", L2);
    return m;
}

fn train_steps(n_steps, seed) {
    h ids = make_corpus();
    h n_pairs = arr_len(ids) - 1;
    tape_reset();
    h model = build_small_model(seed);
    h params = prom_collect_params([dict_get(model, "L1"), dict_get(model, "L2")]);
    h lr = 0.05;
    h step = 0;
    h t0 = time_ms();
    while step < n_steps {
        h k = step - (step / n_pairs) * n_pairs;
        h x = prom_one_hot(arr_get(ids, k), 3);
        h target = prom_one_hot(arr_get(ids, k + 1), 3);
        h L1 = dict_get(model, "L1");
        h L2 = dict_get(model, "L2");
        h h_pre = prom_linear_forward(L1, x);
        h h_post = prom_relu(h_pre);
        h logits = prom_linear_forward(L2, h_post);
        h loss = prom_mse_loss(logits, target);
        tape_backward(loss);
        prom_harmonic_sgd_step(params, lr, 0.3);
        step += 1;
    }
    h t1 = time_ms();
    return t1 - t0;
}

fn run_train_bench() {
    h steps = 500;
    h ms = train_steps(steps, 42);
    h per_step = ms / steps;
    print(concat_many("[TRAIN] ", to_string(steps), " steps  total=",
        to_string(ms), "ms  per_step=", to_string(per_step), "ms"));
    return ms;
}

# ---- 3. dispatch overhead: n_calls to _prom_lcg_step measuring just dispatch -
fn run_dispatch_overhead(n) {
    h s = 1;
    h t0 = time_ms();
    h i = 0;
    while i < n {
        s = _prom_lcg_step(s);
        i += 1;
    }
    h t1 = time_ms();
    h ms = t1 - t0;
    return ms;
}

# ---- main -------------------------------------------------------------------
fn main() {
    print("=== HBit JIT + Harmony-SGD + Dispatch Benchmark ===");
    print("(Set OMC_HBIT_JIT=1 to enable JIT; OMC_HBIT_JIT_VERBOSE=1 to see which fns)");
    print("");

    print("--- 1. LCG integer-function timing (JIT fires here if enabled) ---");
    h lcg_ms = run_lcg_bench();
    print("");

    print("--- 2. Training loop timing (tape ops dominate; JIT is marginal here) ---");
    h train_ms = run_train_bench();
    print("");

    print("--- 3. Dispatch overhead: 10k LCG calls vs 50k from bench 1 ---");
    h d10 = run_dispatch_overhead(10000);
    h d50 = run_dispatch_overhead(50000);
    h per_call_10 = d10 * 1000.0 / 10000.0;
    h per_call_50 = d50 * 1000.0 / 50000.0;
    print(concat_many("  10k calls: ", to_string(d10), "ms  (", to_string(per_call_10), " µs/call)"));
    print(concat_many("  50k calls: ", to_string(d50), "ms  (", to_string(per_call_50), " µs/call)"));
    print("");

    print("--- Summary ---");
    print(concat_many("  LCG 50k:        ", to_string(lcg_ms), "ms"));
    print(concat_many("  Training 500:   ", to_string(train_ms), "ms"));
    print("  (Run with/without OMC_HBIT_JIT=1 and compare these numbers.)");
}

main();
